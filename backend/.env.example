# --- Supabase (mesmo projeto do app Expo) -----------------------------------
SUPABASE_URL=https://seu-projeto.supabase.co
# Service role key (Dashboard > Settings > API). NUNCA colocar no app Expo.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Gemini ------------------------------------------------------------------
GEMINI_API_KEY=AIza...
GEMINI_QUIZ_MODEL=gemini-2.5-flash
GEMINI_FILTER_MODEL=gemini-2.5-flash-lite

# --- Comportamento -----------------------------------------------------------
# false => notícias aprovadas só pelo filtro de palavras-chave (verdict 'skipped')
NEWS_LLM_FILTER=true
HTTP_TIMEOUT_SECONDS=20

# --- API opcional do quiz (uvicorn) -------------------------------------------
QUIZ_API_TOKEN=gere-um-token-forte-aqui
